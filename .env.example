DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=change-this-secret
# Postgres (producción / Railway): misma URL en servicios web y bot. Si está vacío se usa SQLite vía DATABASE_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Pool (opcional, solo Postgres)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# SQLite solo cuando DATABASE_URL no está definido (dev local o legado)
DATABASE_PATH=stickbot.db
DEFAULT_DAILY_LIMIT=3
DEFAULT_COOLDOWN_MINUTES=22
GIT_AUTO_SYNC=0
GIT_AUTO_SYNC_REMOTE=origin
GIT_AUTO_SYNC_BRANCH=main
GIT_AUTO_SYNC_MESSAGE=auto-sync run_all
